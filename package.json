{
	"name": "proto",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"createTry": "pnpm install && pnpm drizzle-kit push && pnpm run db:seeder && pnpm run build",
		"format": "prettier --write .",
		"db:seeder": "pnpm exec node --experimental-strip-types scripts/seeder.ts",
		"db:clean": "pnpm exec node --experimental-strip-types scripts/dbclean.ts",
		"db:reset": "pnpm run db:clean && pnpm run db:seeder"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@sveltejs/adapter-node": "6.0.0-next.10",
		"@sveltejs/kit": "3.0.0-next.14",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"add": "^2.0.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"arktype": "^2.2.3",
		"better-auth": "^1.7.1",
		"diff": "^9.0.0",
		"dotenv": "^17.4.2",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"fast-diff": "^1.3.0"
	}
}
